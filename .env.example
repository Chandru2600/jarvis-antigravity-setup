# JARVIS Antigravity — Example Environment Configuration
# ===================================================================
# Provide your Google Gemini API Key below in .env.local:
# GEMINI_API_KEY=your_gemini_api_key_here
#
# Free Gemini API keys can be generated at: https://aistudio.google.com/
#
# The bridge (Node server) connects to Google Gemini API (gemini-3.1-flash-lite-preview)
# and exposes the brain to the Iron Man Three.js UI over WebSocket (ws://localhost:8787).
#
# Optional: ELEVENLABS_API_KEY provides high-fidelity neural speech.
# Without it, JARVIS speaks and listens cleanly using the browser's native speech APIs.


# ===================================================================
# BRIDGE (the server) — read by bridge/server.mjs & bridge/server_gemini.mjs
# ===================================================================

# Google Gemini API key (Required for AI responses)
GEMINI_API_KEY=

# Model to run. Default: gemini-3.1-flash-lite-preview
# JARVIS_MODEL=gemini-3.1-flash-lite-preview

# Port the bridge listens on (WebSocket + HTTP). Default 8787.
# JARVIS_BRIDGE_PORT=8787

# Allow effectful actions (tools with filesystem/write access). Default 0 (read-only).
# JARVIS_ALLOW_WRITES=0

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# JARVIS_ALLOWED_ORIGINS=

# ElevenLabs voice id for the bridge speech endpoint. Default: George.
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs API key. Optional for premium voice.
# ELEVENLABS_API_KEY=


# ===================================================================
# FRONTEND (Vite) — read by the browser UI
# ===================================================================

# Which backend to connect to. Default: bridge
VITE_BACKEND=bridge

# Where the bridge listens.
VITE_BRIDGE_URL=ws://localhost:8787

# Browser text-to-speech engine. Default: system
# Options: system (instant, on-device) or kokoro (neural in-browser)
VITE_TTS_ENGINE=system

# Optional Picovoice Porcupine AccessKey for local offline wake word ("Hey Jarvis")
# Free access key at https://console.picovoice.ai/
VITE_PICOVOICE_ACCESS_KEY=
